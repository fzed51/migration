{
  "name": "fzed51/migration",
  "description": "Outil en ligne de commande de migration de base de données en SQL pur (MySQL, SQLite, PostgreSQL)",
  "type": "library",
  "keywords": ["migration", "database", "sql", "cli", "mysql", "sqlite", "postgresql"],
  "homepage": "https://github.com/fzed51/migration",
  "license": "MIT",
  "authors": [
    {
      "name": "Fabien Sanchez",
      "email": "fzed51@users.noreply.github.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "fzed51/pdo-helper": "^2.0",
    "symfony/console": "^7.4 || ^8.0"
  },
  "suggest": {
    "ext-pdo_mysql": "pour les bases MySQL",
    "ext-pdo_pgsql": "pour les bases PostgreSQL",
    "ext-pdo_sqlite": "pour les bases SQLite"
  },
  "support": {
    "issues": "https://github.com/fzed51/migration/issues",
    "source": "https://github.com/fzed51/migration"
  },
  "bin": [
    "./bin/migrate"
  ],
  "autoload": {
    "psr-4": {
      "Migration\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Migration\\": "./test"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpcsstandards/php_codesniffer": "^3.11",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "lint" : [
      "composer validate",
      "phpcs",
      "phpstan"
    ],
    "test" : "phpunit"
  }
}
